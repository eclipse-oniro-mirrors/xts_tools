# Text files: normalize line endings to LF in repo and working tree
*.ets text eol=lf
*.ats text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.gn text eol=lf
*.gni text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.html text eol=lf
*.css text eol=lf
*.hml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.patch text eol=lf
*.clang-format text eol=lf
*.clang-tidy text eol=lf
*.clangd text eol=lf
.gitignore text eol=lf

# Windows-only scripts: keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
