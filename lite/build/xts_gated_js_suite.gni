# Compile a lite JS suite with exactly the page set given by `pages` (plain
# route strings; gate with GN `if` in the suite BUILD.gn). Produces:
#   <out>/<name>/main        staged source tree for the webpack root
#   <out>/<name>/config.json config.json variant for hap_pack json_path
# Keep the path short: ace-lite bundles key every module by its request path
# relative to the ace-loader, so a deep staging path inflates the HAP.

template("xts_gated_js_suite") {
  assert(defined(invoker.src_root), "src_root is required")
  assert(defined(invoker.config_json), "config_json is required")
  assert(defined(invoker.pages), "pages is required")

  _out_dir = "$root_out_dir/${target_name}"

  write_file("${_out_dir}/spec.txt", invoker.pages)

  _inputs = [
    invoker.config_json,
    invoker.src_root + "/app.js",
    invoker.src_root + "/manifest.json",
  ]
  foreach(p, invoker.pages) {
    _inputs += [
      invoker.src_root + "/" + p + ".js",
      invoker.src_root + "/" + p + ".hml",
      invoker.src_root + "/" + p + ".css",
    ]
  }
  if (defined(invoker.extra_sources)) {
    foreach(s, invoker.extra_sources) {
      _inputs += [ invoker.src_root + "/" + s ]
    }
  }

  action("${target_name}_render") {
    script = "//test/xts/tools/lite/build/render_gated_js_suite.py"
    sources = _inputs
    sources += [ "${_out_dir}/spec.txt" ]
    outputs = [
      "${_out_dir}/main/manifest.json",
      "${_out_dir}/config.json",
    ]
    args = [
      "--src-root",
      rebase_path(invoker.src_root),
      "--staged-dir",
      rebase_path("${_out_dir}/main"),
      "--spec",
      rebase_path("${_out_dir}/spec.txt"),
      "--config-src",
      rebase_path(invoker.config_json),
      "--config-out",
      rebase_path("${_out_dir}/config.json"),
    ]
  }
}
